# ===== 密钥与环境变量（务必保留此规则）=====
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml

# ===== 大体积媒体文件（GitHub 单文件上限 100MB）=====
*.mp4
*.mov
*.avi
*.mkv
*.flv
*.wmv
*.webm
*.iso

# ===== 大型安装包 / 模型权重 =====
Miniconda3-*.sh
Miniconda3-*.exe
Anaconda3-*.sh
*.whl
*.tar.gz
*.7z
*.rar
*.pt
*.pth
*.onnx
*.ckpt
*.safetensors

# ===== 数据库与运行时产物 =====
*.db
*.sqlite
*.sqlite3
*.log
logs/
runtime/
uploads/

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Node / 前端构建 =====
node_modules/
dist/
build/
.vite/
*.local

# ===== IDE / 系统 =====
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ===== 临时文件 =====
*.tmp
*.bak
*.swp
~$*
# ===== 运行时数据目录（保留 .gitkeep 占位）=====
data/*
!data/.gitkeep
