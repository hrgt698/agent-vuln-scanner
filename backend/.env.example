# ============================================================
# Agent Vulnerability Assessment Platform - 环境变量配置示例
# 复制此文件为 .env 并填入你的配置
# ============================================================

# ---- 通义千问 API Key（必填，用于 AI 研判报告和 Embedding）----
# 获取方式：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- JWT 动态 Token 认证（v2.3 新增，生产环境必填）----
# ⚠️  必须设置至少 32 字符的随机密钥
# 生成方式（Linux/macOS/Windows Git-Bash）：
#   openssl rand -hex 32
# 生成方式（Windows PowerShell）：
#   $bytes = New-Object byte[] 32; rng.GetBytes($bytes); [Convert]::ToHexString($bytes)
# ⚠️  禁止使用以下弱密钥（已被代码强制校验）：
#   - "TEMPORARY_SECRET_FOR_DEV_ONLY_CHANGE_ME"
#   - "CHANGE_ME" / "dev_secret" / "your-secret-here" / "secret"
# ⚠️  生产环境（ENV=production）检测到弱密钥将抛出 ValueError 阻断启动
# 用途：为所有 POST /api/* 请求生成带过期时间的 JWT Token
JWT_SECRET=your_strong_random_secret_here__use_openssl_rand_hex_32

# ---- API 访问控制（已废弃，使用 JWT 替代）----
# API_KEY=your_secure_random_api_key_here

# ---- 靶机地址（可选，从 config.yaml 读取，此处可覆盖）----
TARGET_URL=http://127.0.0.1:18789

# ---- Python 运行模式 ----
ENV=development
PYTHONUNBUFFERED=1
