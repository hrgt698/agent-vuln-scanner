# ============================================================
# 前端环境变量配置示例
# 复制此文件为 .env.local 并填入实际值
# .env.local 不会被 git 提交
# ============================================================

# API 后端地址（默认为本地后端）
VITE_API_BASE_URL=http://127.0.0.1:8000

# API 代理目标（开发环境跨域代理）
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 是否启用调试模式
VITE_DEBUG=false

# 是否启用 Mock 数据（无后端时使用）
VITE_USE_MOCK=false
